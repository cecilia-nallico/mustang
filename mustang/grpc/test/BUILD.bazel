load("//mustang/grpc:protobuf.bzl", "mustang_grpc_proto")
load("//tools:defaults.bzl", "mustang_cc_test")

mustang_grpc_proto(
    name = "echo_proto",
    srcs = ["echo.proto"],
    visibility = ["//visibility:private"],
)

mustang_cc_test(
    name = "typed_test",
    srcs = ["typed_test.cc"],
    deps = [
        ":echo_proto",
        "//mustang:runtime",
        "//mustang/grpc:call",
        "//mustang/grpc:server",
        "//mustang/grpc:typed",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest_main",
    ],
)
