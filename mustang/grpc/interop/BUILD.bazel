load("//mustang/grpc:protobuf.bzl", "mustang_grpc_java_proto", "mustang_grpc_proto")
load("//tools:defaults.bzl", "mustang_cc_binary")

mustang_grpc_proto(
    name = "interop_proto",
    srcs = ["interop.proto"],
    visibility = ["//visibility:private"],
)

mustang_grpc_java_proto(
    name = "interop_java_proto",
    srcs = ["interop.proto"],
    holders = ["Interop"],
    java_package = "mustang.interop",
    messages = [
        "MetadataRequest",
        "SimpleRequest",
        "SimpleResponse",
        "StreamRequest",
    ],
    services = ["TestService"],
    visibility = ["//visibility:public"],
)

mustang_cc_binary(
    name = "java_interop_server",
    srcs = ["java_interop_server.cc"],
    visibility = ["//visibility:public"],
    # Launched by //tools:java_interop_test.
    deps = [
        ":interop_proto",
        "//mustang:runtime",
        "//mustang/grpc:call",
        "//mustang/grpc:server",
        "//mustang/grpc:typed",
        "@abseil-cpp//absl/strings",
    ],
)
