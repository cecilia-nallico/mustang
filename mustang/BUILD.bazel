load("//tools:defaults.bzl", "mustang_cc_binary", "mustang_cc_library", "mustang_cc_test")

mustang_cc_library(
    name = "greet",
    srcs = ["greet.cc"],
    hdrs = ["greet.h"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
    ],
)

mustang_cc_library(
    name = "runtime",
    srcs = ["runtime.cc"],
    hdrs = ["photon_headers.h", "runtime.h"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "//third_party/photon",
    ],
)

mustang_cc_binary(
    name = "mustang",
    srcs = ["main.cc"],
    # Run by //tools:mustang_e2e_test.
    visibility = ["//visibility:public"],
    deps = [
        ":greet",
        ":runtime",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/status",
        "//third_party/photon",
    ],
)

mustang_cc_test(
    name = "greet_test",
    srcs = ["greet_test.cc"],
    deps = [
        ":greet",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest_main",
    ],
)

mustang_cc_test(
    name = "runtime_test",
    srcs = ["runtime_test.cc"],
    deps = [
        ":runtime",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest_main",
        "//third_party/photon",
    ],
)
