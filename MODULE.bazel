module(
    name = "walleye",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "curl", version = "8.23.0")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")

bazel_dep(name = "grpc", version = "1.85.4", dev_dependency = True)

bazel_dep(name = "liburing", version = "2.15")
bazel_dep(name = "platforms", version = "1.1.0")

bazel_dep(name = "protobuf", version = "36.2", dev_dependency = True)
bazel_dep(name = "rules_java", version = "9.9.0", dev_dependency = True)
bazel_dep(name = "rules_jvm_external", version = "6.9", dev_dependency = True)

# Official gRPC Java client as Maven artifacts (the consumer-correct way;
# building grpc-java from source via the BCR module drags in conflicting
# maven universes from its android deps).
# Official gRPC Java protoc plugin (prebuilt from Maven Central).
grpc_java_plugin = use_repo_rule("//tools:grpc_java_plugin.bzl", "grpc_java_plugin")

grpc_java_plugin(
    name = "protoc_gen_grpc_java",
    sha256 = "907c2d4efc2bae9b21cada75c31b36f3821e15b7be96311e214a6be65bcd20aa",
    urls = ["https://repo1.maven.org/maven2/io/grpc/protoc-gen-grpc-java/1.84.0/protoc-gen-grpc-java-1.84.0-linux-x86_64.exe"],
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "com.google.protobuf:protobuf-java:4.36.2",
        "io.grpc:grpc-api:1.84.0",
        "io.grpc:grpc-netty:1.84.0",
        "io.grpc:grpc-protobuf:1.84.0",
        "io.grpc:grpc-stub:1.84.0",
    ],
)
use_repo(maven, "maven")

bazel_dep(name = "rules_proto", version = "7.1.0", dev_dependency = True)

bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_shell", version = "0.10.0")
